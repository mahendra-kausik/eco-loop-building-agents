# Copy to .env and fill in. NEVER commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Fallback provider (optional — code must work with this left blank, falling
# straight through to the rule-based fallback schedule in src/agent/fallback.py)
FALLBACK_BASE_URL=https://api.cerebras.ai/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=gpt-oss-120b
# EnergyPlus install directory (contains pyenergyplus/)
ENERGYPLUS_DIR=
# Decision cadence & safety
DECISION_INTERVAL_SIM_HOURS=1
LLM_TIMEOUT_SECONDS=15
