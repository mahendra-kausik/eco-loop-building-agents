# Copy to .env and fill in. NEVER commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Cerebras — the PREFERRED provider (1M tokens/day vs Groq's 200K on the same
# model; see docs/ARCHITECTURE.md "Provider selection"). Either provider's key
# may be left blank — the client round-robins whichever are configured, and with
# both blank falls straight through to the rule-based schedule in
# src/agent/fallback.py rather than erroring.
CEREBRAS_API_KEY=
FALLBACK_BASE_URL=https://api.cerebras.ai/v1
FALLBACK_MODEL=gpt-oss-120b
# Legacy alias for CEREBRAS_API_KEY, still honored for existing .env files:
# FALLBACK_API_KEY=
# EnergyPlus install directory (contains pyenergyplus/)
ENERGYPLUS_DIR=
# Decision cadence & safety
DECISION_INTERVAL_SIM_HOURS=1
LLM_TIMEOUT_SECONDS=15
# Minimum real-time seconds between calls to the SAME provider (not the
# simulated decision cadence above, which stays hourly). LEAVE UNSET on free
# tiers: llm_client.py then applies a per-provider floor sized to each
# provider's own binding limit (Groq is token-per-minute bound ~17s, Cerebras
# is request-per-minute bound ~12s -- they invert; see docs/ARCHITECTURE.md's
# "Rate limiting" section). Setting this overrides BOTH with one value, which
# is only worth doing on a paid tier with more headroom (lower it) or to force
# a uniform conservative floor (raise it).
# LLM_MIN_CALL_INTERVAL_SECONDS=
